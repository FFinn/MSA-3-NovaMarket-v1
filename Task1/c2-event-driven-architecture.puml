@startuml
!include <C4/C4_Container>
LAYOUT_TOP_DOWN()
title NovaMarket — контейнерная диаграмма C2, MVP и событийное взаимодействие

Person(customer, "Покупатель", "Смотрит каталог и оформляет заказ в мобильном приложении.")
Person(seller, "Продавец", "Получает уведомления о новых заказах.")
System_Ext(payment, "Платёжный провайдер", "Подтверждает или отклоняет оплату.")
System_Ext(logistics, "Логистический провайдер", "Создаёт доставку и сообщает её статус.")

System_Boundary(novamarket, "NovaMarket") {
  Container(mobile, "Мобильное приложение", "iOS / Android", "Клиент MVP. Все запросы идут через API Gateway.")
  Container(gateway, "API Gateway", "NGINX", "Маршрутизация, TLS, проверка доступа, ограничение частоты запросов.")
  Container(catalog, "Catalog Service", "Микросервис + БД каталога", "Каталог, цены, доступность товаров.")
  Container(order, "Order Service", "Микросервис + БД заказов", "Создаёт заказ и ведёт Saga. События пишет в outbox в той же транзакции.")
  Container(paymentService, "Payment Service", "Микросервис + БД платежей", "Инициирует оплату и выполняет компенсационный возврат.")
  Container(delivery, "Delivery Service", "Микросервис + БД доставок", "Создаёт и отслеживает доставку у внешнего провайдера.")
  Container(notification, "Notification Service", "Микросервис + БД уведомлений", "Уведомляет продавцов о подтверждённых заказах.")
  ContainerQueue(kafka, "Kafka", "Брокер событий", "Асинхронная шина доменных событий. События одного заказа попадают в одну партицию по orderId.")
}

Rel(customer, mobile, "Использует")
Rel(mobile, gateway, "HTTPS/JSON")
Rel(gateway, catalog, "Запрос каталога", "REST")
Rel(gateway, order, "Создание и просмотр заказа", "REST")
Rel(order, kafka, "OrderCreated, OrderConfirmed, OrderCancelled", "публикация через outbox")
Rel(kafka, paymentService, "OrderCreated", "подписка")
Rel(paymentService, payment, "Оплата / возврат", "HTTPS")
Rel(paymentService, kafka, "PaymentSucceeded, PaymentFailed, PaymentRefunded", "публикация")
Rel(kafka, delivery, "PaymentSucceeded, OrderCancelled", "подписка")
Rel(delivery, logistics, "Создание / отмена доставки", "HTTPS")
Rel(delivery, kafka, "DeliveryCreated, DeliveryCreationFailed, DeliveryCancelled", "публикация")
Rel(kafka, order, "Payment* и Delivery*", "подписка; продолжение Saga")
Rel(kafka, notification, "OrderConfirmed", "подписка")
Rel(notification, seller, "Новое подтверждённое оформление", "push/e-mail")
@enduml
