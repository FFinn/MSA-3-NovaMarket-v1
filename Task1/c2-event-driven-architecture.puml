@startuml
!include <C4/C4_Container>
LAYOUT_TOP_DOWN()
title NovaMarket — контейнерная диаграмма C2, MVP и событийное взаимодействие

Person(customer, "Покупатель", "Выбирает товары, ведёт корзину, оформляет и отслеживает заказ.")
Person(seller, "Продавец", "Получает заказ на сборку и видит статусы своих заказов.")
System_Ext(paymentProvider, "Платёжный провайдер", "Принимает оплату, возвращает её при компенсации.")
System_Ext(logisticsProvider, "Логистический провайдер", "Создаёт доставку, выдаёт трек-номер и сообщает статус.")

System_Boundary(novamarket, "NovaMarket") {
  Container(customerApp, "Клиентское приложение", "iOS / Android", "Каталог, отзывы, корзина, оформление и отслеживание заказа.")
  Container(sellerApp, "Кабинет продавца", "Web / Mobile", "Новые заказы и статусы сборки/доставки.")
  Container(gateway, "API Gateway", "NGINX", "Единая точка входа: маршрутизация, TLS, проверка доступа и rate limiting.")
  Container(catalog, "Catalog Service", "Микросервис + БД каталога", "Карточки, категории, цены, фото и описания товаров.")
  Container(review, "Review Service", "Микросервис + БД отзывов", "Отзывы и рейтинг товаров.")
  Container(cart, "Cart Service", "Микросервис + БД/Redis", "Корзина покупателя до создания заказа.")
  Container(order, "Order Service", "Микросервис + БД заказов", "Владелец заказа: хранит состав, адрес, оплату и реактивно меняет статус по событиям.")
  Container(inventory, "Inventory Service", "Микросервис + БД склада", "Проверяет остатки, резервирует и освобождает товары.")
  Container(payment, "Payment Service", "Микросервис + БД платежей", "Создаёт платёж, принимает его результат и возвращает деньги при компенсации.")
  Container(delivery, "Delivery Service", "Микросервис + БД доставок", "Создаёт доставку, хранит трек-номер и транслирует её статусы.")
  Container(notification, "Notification Service", "Микросервис + БД уведомлений", "Уведомляет продавца о заказе, требующем сборки.")
  ContainerQueue(kafka, "Kafka", "Брокер событий", "Асинхронная шина. События одного заказа попадают в одну партицию по orderId.")
}

Rel(customer, customerApp, "Использует")
Rel(seller, sellerApp, "Использует")
Rel(customerApp, gateway, "HTTPS/JSON")
Rel(sellerApp, gateway, "HTTPS/JSON")
Rel(gateway, catalog, "Каталог и карточка товара", "REST")
Rel(gateway, review, "Отзывы и рейтинг", "REST")
Rel(gateway, cart, "Корзина", "REST")
Rel(gateway, order, "Оформление и статус заказа; список заказов продавца", "REST")
Rel(gateway, delivery, "Трек-номер и статус доставки", "REST")

Rel(order, kafka, "OrderCreated, OrderCancelled, OrderConfirmed", "публикация через outbox")
Rel(kafka, inventory, "OrderCreated, PaymentFailed, DeliveryCreationFailed", "подписка")
Rel(inventory, kafka, "InventoryReserved, InventoryReservationFailed, InventoryReservationReleased", "публикация")
Rel(kafka, payment, "InventoryReserved, DeliveryCreationFailed", "подписка")
Rel(payment, paymentProvider, "Оплата / возврат", "HTTPS")
Rel(payment, kafka, "PaymentSucceeded, PaymentFailed, PaymentRefunded, PaymentRefundFailed", "публикация")
Rel(kafka, delivery, "PaymentSucceeded, OrderCancelled", "подписка")
Rel(delivery, logisticsProvider, "Создание/отмена доставки; получение статуса", "HTTPS")
Rel(delivery, kafka, "DeliveryCreated, DeliveryCreationFailed, DeliveryStatusChanged, DeliveryCancelled", "публикация")
Rel(kafka, order, "Inventory*, Payment*, Delivery*", "подписка; изменение состояния своего заказа")
Rel(kafka, notification, "OrderConfirmed", "подписка")
Rel(notification, seller, "Заказ готов к сборке", "push/e-mail")
@enduml
