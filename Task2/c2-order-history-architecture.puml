@startuml
!include <C4/C4_Container>
LAYOUT_TOP_DOWN()
title NovaMarket — C2 после добавления истории покупок

Person(customer, "Покупатель", "Просматривает историю, скачивает чек, оставляет отзыв и повторяет заказ.")
Person(seller, "Продавец", "Получает заказы на сборку и видит их статусы.")
System_Ext(paymentProvider, "Платёжный провайдер", "Подтверждает оплату и возврат.")
System_Ext(logisticsProvider, "Логистический провайдер", "Создаёт доставку и сообщает статус/трек-номер.")
System_Ext(receipt, "Сервис чеков", "Формирует и хранит юридически значимые чеки.")

System_Boundary(novamarket, "NovaMarket") {
  Container(customerApp, "Клиентские каналы", "Мобильное приложение / веб-сайт / чат-бот", "Личный кабинет, каталог, корзина и оформление заказа.")
  Container(sellerApp, "Кабинет продавца", "Веб-интерфейс / мобильное приложение", "Заказы, сборка и статусы доставки.")
  Container(gateway, "Шлюз API", "NGINX", "Единая точка входа, проверка доступа и ограничение частоты запросов.")
  Container(bff, "BFF покупателя", "Ограниченная композиция API", "Контракт под экраны истории для мобильного приложения, сайта и чат-бота.")

  Container(catalog, "Catalog Service", "Микросервис + БД каталога", "Карточки, цены, фото, описания, фильтры и проекция доступности товара.")
  Container(review, "Review Service", "Микросервис + БД отзывов", "Отзывы доставленных товаров.")
  Container(cart, "Cart Service", "Микросервис + БД/Redis", "Корзина покупателя.")
  Container(order, "Order Service", "Микросервис + БД заказов", "Владелец заказа и снимка товарных позиций/цен на момент оформления.")
  Container(inventory, "Inventory Service", "Микросервис + БД склада", "Проверка остатков, резервирование и освобождение товаров.")
  Container(payment, "Payment Service", "Микросервис + БД платежей", "Оплата и компенсационный возврат.")
  Container(delivery, "Delivery Service", "Микросервис + БД доставок", "Доставка, трек-номер, предполагаемая дата и финальный статус.")
  Container(notification, "Notification Service", "Микросервис + БД уведомлений", "Уведомляет продавца о заказе, требующем сборки.")

  Container(history, "Сервис проекции истории", "CQRS, модель чтения", "Потребляет события и отдаёт готовый API истории. Не вызывает доменные сервисы при чтении.")
  ContainerDb(historyDb, "БД истории заказов", "PostgreSQL / документная БД", "Денормализованная модель чтения, индексированная по customerId и дате заказа.")
  ContainerQueue(kafka, "Kafka", "Брокер событий", "Доменные события. Партиционирование по orderId.")
}

Rel(customer, customerApp, "Использует")
Rel(seller, sellerApp, "Использует")
Rel(customerApp, gateway, "HTTPS/JSON")
Rel(sellerApp, gateway, "HTTPS/JSON")
Rel(gateway, bff, "GET /me/orders, GET /me/orders/{id}", "HTTPS/JSON")
Rel(bff, history, "Получить список и детали истории", "API чтения")
Rel(history, historyDb, "Читает и обновляет модель чтения", "SQL")
Rel(bff, receipt, "Получить подписанную ссылку на чек", "HTTPS, только по действию покупателя")
Rel(bff, order, "Повторить заказ", "команда")
Rel(bff, review, "Оставить отзыв", "команда")

Rel(gateway, catalog, "Каталог и карточка товара", "REST")
Rel(gateway, review, "Просмотр отзывов", "REST")
Rel(gateway, cart, "Корзина", "REST")
Rel(gateway, order, "Оформление и статусы заказов", "REST")
Rel(gateway, delivery, "Трек-номер и статус доставки", "REST")

Rel(order, kafka, "OrderCreated (снимок товаров/цен), OrderConfirmed, OrderCancelled", "публикация через таблицу исходящих сообщений")
Rel(kafka, inventory, "OrderCreated, PaymentFailed, DeliveryCreationFailed", "подписка")
Rel(inventory, kafka, "InventoryReserved, InventoryReservationFailed, InventoryReservationReleased, ProductAvailabilityChanged", "публикация")
Rel(kafka, catalog, "ProductAvailabilityChanged", "подписка; обновление доступности в каталоге")
Rel(kafka, payment, "InventoryReserved, DeliveryCreationFailed", "подписка")
Rel(payment, paymentProvider, "Оплата / возврат", "HTTPS")
Rel(payment, kafka, "PaymentCreated, PaymentSucceeded, PaymentFailed, PaymentRefunded, PaymentRefundFailed", "публикация")
Rel(kafka, delivery, "PaymentSucceeded, OrderCancelled", "подписка")
Rel(delivery, logisticsProvider, "Создание/отмена доставки; статусы", "HTTPS")
Rel(delivery, kafka, "DeliveryCreated, DeliveryCreationFailed, DeliveryStatusChanged, DeliveryCancelled", "публикация")
Rel(kafka, order, "Inventory*, Payment*, Delivery*", "подписка")
Rel(kafka, notification, "OrderConfirmed", "подписка")
Rel(notification, seller, "Заказ готов к сборке", "уведомление / электронная почта")

Rel(kafka, history, "Order*, Payment*, Delivery*", "подписка; создание/обновление проекции")
@enduml
