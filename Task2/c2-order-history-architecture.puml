@startuml
!include <C4/C4_Container>
LAYOUT_TOP_DOWN()
title NovaMarket — контейнерная диаграмма C2 после добавления истории покупок

Person(customer, "Покупатель", "Смотрит список и детали своих заказов.")
System_Ext(receipt, "Сервис чеков", "Формирует/хранит юридически значимые чеки.")
System_Boundary(novamarket, "NovaMarket") {
 Container(mobile, "Клиенты", "Мобильное приложение / сайт / чат-бот", "Несколько клиентских каналов.")
 Container(gateway, "API Gateway", "NGINX", "Единая точка входа.")
 Container(bff, "Customer BFF", "API Composition", "Отдаёт данные под экраны клиента. В обычном сценарии читает готовую историю.")
 Container(history, "History Projection Service", "CQRS-модель чтения", "Читает события и поддерживает проекцию заказа, строк товаров, доставки, оплаты и ссылки на чек.")
 ContainerDb(historyDb, "Order History DB", "PostgreSQL / документная БД", "Модель чтения с индексом по customerId и дате заказа.")
 ContainerQueue(kafka, "Kafka", "Брокер событий", "Доменные события из Task1.")
 Container(order, "Order Service", "Микросервис", "Источник истины статуса заказа.")
 Container(review, "Review Service", "Микросервис", "Принимает отзывы покупателей по доставленным товарам.")
 Container(catalog, "Catalog Service", "Микросервис", "Источник названий/изображений товаров.")
 Container(payment, "Payment Service", "Микросервис", "Источник оплаты.")
 Container(delivery, "Delivery Service", "Микросервис", "Источник доставки.")
}
Rel(customer, mobile, "Использует")
Rel(mobile, gateway, "HTTPS")
Rel(gateway, bff, "GET /me/orders, /me/orders/{id}")
Rel(bff, historyDb, "Один запрос на список или детали", "SQL / API чтения")
Rel(bff, receipt, "Получает ссылку на скачивание чека", "HTTPS, только по запросу")
Rel(bff, order, "Повтор заказа", "команда")
Rel(bff, review, "Оставить отзыв", "команда")
Rel(order, kafka, "OrderCreated, OrderConfirmed, OrderCancelled", "публикация")
Rel(payment, kafka, "PaymentSucceeded, PaymentRefunded", "публикация")
Rel(delivery, kafka, "DeliveryCreated, DeliveryCancelled", "публикация")
Rel(catalog, kafka, "ProductSnapshotChanged", "публикация")
Rel(kafka, history, "Подписка на события", "чтение")
Rel(history, historyDb, "Создаёт и обновляет модель чтения")
@enduml
